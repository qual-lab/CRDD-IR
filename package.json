{
  "name": "crdd-ir",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "crdd-ir": "./src/cli.ts"
  },
  "files": [
    "src",
    "schemas",
    "scripts",
    "templates",
    "README.md"
  ],
  "scripts": {
    "lint:ir": "node src/cli.ts lint examples/create-entity/create-entity.ir.json",
    "check:source": "node src/cli.ts check examples/create-entity/05_SPEC/01_Behavior_Specification.md",
    "compile:source": "node src/cli.ts compile examples/create-entity/05_SPEC/01_Behavior_Specification.md --out .crdd-ir/create-entity.ir.json",
    "simulate": "node src/cli.ts simulate examples/create-entity/05_SPEC/01_Behavior_Specification.md",
    "test:generate": "node src/cli.ts test generate examples/create-entity/05_SPEC/01_Behavior_Specification.md",
    "test:contract": "node src/cli.ts test run examples/create-entity/05_SPEC/01_Behavior_Specification.md",
    "test:adapter": "node src/cli.ts test run examples/create-entity/05_SPEC/01_Behavior_Specification.md --adapter examples/create-entity/adapters/correct.adapter.ts",
    "test:process": "node src/cli.ts test run examples/create-entity/05_SPEC/01_Behavior_Specification.md --command node --arg examples/create-entity/adapters/process-correct.ts",
    "test:bundle": "node src/cli.ts test bundle examples/create-entity/05_SPEC/01_Behavior_Specification.md",
    "test:bundle:source": "node src/cli.ts test bundle examples/create-entity/05_SPEC/01_Behavior_Specification.md --out generated/create-entity.conformance.json",
    "generate:unreal": "node src/cli.ts unreal generate examples/create-entity/05_SPEC/01_Behavior_Specification.md --profile examples/unreal/profiles/ue-5.8-editor.json --out-dir generated/unreal",
    "generate:assets": "node src/cli.ts generate assets examples/create-entity/05_SPEC/01_Behavior_Specification.md",
    "generate:evidence": "node src/cli.ts generate evidence examples/create-entity/05_SPEC/01_Behavior_Specification.md --out-dir examples/create-entity/07_Quality/CRDD_IR --unreal-report examples/unreal/CrddCompilerFixture/Saved/TestReports/index.json",
    "verify:unreal": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify-unreal.ps1",
    "pack:check": "npm pack --dry-run",
    "test:installer": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File test/install-project.test.ps1",
    "test": "node --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "yaml": "2.9.0"
  }
}
