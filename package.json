{
  "name": "crdd-ir",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "crdd-ir": "./src/cli.ts"
  },
  "scripts": {
    "lint:ir": "node src/cli.ts lint examples/place-wall/place-wall.ir.json",
    "check:source": "node src/cli.ts check examples/place-wall/05_SPEC/01_Behavior_Specification.md",
    "compile:source": "node src/cli.ts compile examples/place-wall/05_SPEC/01_Behavior_Specification.md --out .crdd-ir/place-wall.ir.json",
    "simulate": "node src/cli.ts simulate examples/place-wall/05_SPEC/01_Behavior_Specification.md",
    "test:generate": "node src/cli.ts test generate examples/place-wall/05_SPEC/01_Behavior_Specification.md",
    "test:contract": "node src/cli.ts test run examples/place-wall/05_SPEC/01_Behavior_Specification.md",
    "test:adapter": "node src/cli.ts test run examples/place-wall/05_SPEC/01_Behavior_Specification.md --adapter examples/place-wall/adapters/correct.adapter.ts",
    "test:process": "node src/cli.ts test run examples/place-wall/05_SPEC/01_Behavior_Specification.md --command node --arg examples/place-wall/adapters/process-correct.ts",
    "test:bundle": "node src/cli.ts test bundle examples/place-wall/05_SPEC/01_Behavior_Specification.md",
    "test:bundle:source": "node src/cli.ts test bundle examples/place-wall/05_SPEC/01_Behavior_Specification.md --out generated/place-wall.conformance.json",
    "generate:unreal": "node src/cli.ts generate unreal examples/place-wall/05_SPEC/01_Behavior_Specification.md",
    "generate:evidence": "node src/cli.ts generate evidence examples/place-wall/05_SPEC/01_Behavior_Specification.md --out-dir examples/place-wall/07_Quality/CRDD_IR --unreal-report examples/unreal/CrddCompilerFixture/Saved/TestReports/index.json",
    "verify:unreal": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify-unreal.ps1",
    "test": "node --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "yaml": "2.9.0"
  }
}
