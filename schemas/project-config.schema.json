{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crdd.dev/schema/project-config/v0.2.json",
  "title": "CRDD IR Project Configuration v0.2",
  "type": "object",
  "required": ["protocol", "toolRoot", "sources", "evidence", "targets"],
  "properties": {
    "protocol": { "const": "crdd-ir/project-config-v0.2" },
    "toolRoot": { "$ref": "#/$defs/path" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    },
    "evidence": { "$ref": "#/$defs/path" },
    "targets": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": { "$ref": "#/$defs/target" }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "required": ["output"],
      "properties": {
        "output": { "$ref": "#/$defs/path" },
        "profile": { "$ref": "#/$defs/path" },
        "module": { "$ref": "#/$defs/path" },
        "options": { "type": "object" }
      },
      "additionalProperties": false
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
    }
  },
  "additionalProperties": false
}
