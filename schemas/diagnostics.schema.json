{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crdd.dev/schema/diagnostics/v0.1.json",
  "title": "CRDD IR Diagnostics v0.1",
  "type": "object",
  "required": ["protocol", "ok", "diagnostics"],
  "properties": {
    "protocol": { "const": "crdd-ir/diagnostics-v0.1" },
    "ok": { "type": "boolean" },
    "source": { "type": "string" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "path", "message"],
        "properties": {
          "code": { "type": "string", "pattern": "^CRDD_[A-Z0-9_]+$" },
          "severity": { "enum": ["error", "warning"] },
          "path": { "type": "string" },
          "message": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
