{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crdd.dev/schema/target-parity/v0.2.json",
  "title": "CRDD IR Target Parity Report v0.2",
  "type": "object",
  "required": [
    "protocol",
    "requirements",
    "operation",
    "irSha256",
    "conformanceSha256",
    "portableRulesSha256",
    "targets",
    "numericProjections",
    "checks",
    "equivalent"
  ],
  "properties": {
    "protocol": { "const": "crdd-ir/target-parity-v0.2" },
    "requirements": {
      "type": "array",
      "contains": { "const": "IR-PARITY-001" }
    },
    "operation": { "type": "string", "minLength": 1 },
    "irSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "conformanceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "portableRulesSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "targets": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "profileSha256", "irSha256", "conformanceSha256", "portableRulesSha256", "generatedFiles"],
        "properties": {
          "id": { "enum": ["unreal", "unity"] },
          "profileSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "irSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "conformanceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "portableRulesSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "generatedFiles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path", "sha256"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "numericProjections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["unit", "unreal", "unity", "equivalent"],
        "properties": {
          "unit": { "type": "string", "minLength": 1 },
          "unreal": { "$ref": "#/$defs/numericProjection" },
          "unity": { "$ref": "#/$defs/numericProjection" },
          "equivalent": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "object",
      "required": [
        "independentTargetOutputs",
        "sharedSourceIr",
        "sharedConformanceSemantics",
        "equivalentNumericProjections",
        "sharedPortableRuleSemantics"
      ],
      "properties": {
        "independentTargetOutputs": { "type": "boolean" },
        "sharedSourceIr": { "type": "boolean" },
        "sharedConformanceSemantics": { "type": "boolean" },
        "equivalentNumericProjections": { "type": "boolean" },
        "sharedPortableRuleSemantics": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "equivalent": { "type": "boolean" }
  },
  "$defs": {
    "numericProjection": {
      "type": "object",
      "required": ["kind", "bits", "jsonRepresentation", "rounding", "overflow"],
      "properties": {
        "kind": { "enum": ["signed-integer", "binary-float"] },
        "bits": { "enum": [32, 64] },
        "jsonRepresentation": { "enum": ["number", "decimal-string"] },
        "rounding": { "enum": ["reject", "nearest", "floor", "ceil"] },
        "overflow": { "enum": ["error", "clamp"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
