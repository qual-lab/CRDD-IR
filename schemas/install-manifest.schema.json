{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crdd.dev/schema/install-manifest/v0.2.json",
  "title": "CRDD IR Installation Manifest v0.2",
  "type": "object",
  "required": ["protocol", "toolVersion", "files"],
  "properties": {
    "protocol": { "const": "crdd-ir/install-manifest-v0.2" },
    "toolVersion": { "type": "string", "minLength": 1 },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "kind", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["file", "managed-block"] },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
