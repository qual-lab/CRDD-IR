{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crdd.dev/schema/batch-manifest/v0.1.json",
  "title": "CRDD IR Batch Manifest v0.1",
  "type": "object",
  "required": ["protocol", "target", "layout", "operations"],
  "properties": {
    "protocol": { "const": "crdd-ir/batch-v0.1" },
    "target": { "enum": ["ir", "unreal", "assets"] },
    "layout": { "enum": ["operation-directories", "flat"] },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "source", "digest", "outputDirectory", "files"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "outputDirectory": { "type": "string", "minLength": 1 },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "sha256"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
