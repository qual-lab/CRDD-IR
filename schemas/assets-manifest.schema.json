{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crdd.dev/schema/assets-manifest/v0.2.json",
  "title": "CRDD Generated Assets Manifest v0.2",
  "type": "object",
  "required": ["protocol", "operation", "coordinateSystem", "units", "scene", "assets"],
  "properties": {
    "protocol": { "const": "crdd-ir/assets-v0.2" },
    "operation": { "type": "string", "minLength": 1 },
    "coordinateSystem": { "const": "right-handed-z-up" },
    "units": {
      "type": "object",
      "required": ["distance", "angle"],
      "properties": {
        "distance": { "const": "cm" },
        "angle": { "const": "deg" }
      },
      "additionalProperties": false
    },
    "scene": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" }
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "source", "previewScene", "dimensions", "collision", "lod", "placement", "traces"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
          "source": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*\\.generated\\.obj$" },
          "previewScene": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
          "dimensions": {
            "type": "object",
            "required": ["length", "width", "height"],
            "properties": {
              "length": { "type": "number", "exclusiveMinimum": 0 },
              "width": { "type": "number", "exclusiveMinimum": 0 },
              "height": { "type": "number", "exclusiveMinimum": 0 }
            },
            "additionalProperties": false
          },
          "collision": { "$ref": "#/$defs/collision" },
          "lod": { "$ref": "#/$defs/lod" },
          "placement": {
            "type": "object",
            "required": ["location", "rotation"],
            "properties": {
              "location": { "$ref": "#/$defs/vector" },
              "rotation": { "$ref": "#/$defs/rotation" }
            },
            "additionalProperties": false
          },
          "traces": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "collision": {
      "type": "object",
      "required": ["shape"],
      "properties": {
        "shape": { "enum": ["box", "capsule", "sphere", "ndop26"] }
      },
      "additionalProperties": false
    },
    "lod": {
      "type": "object",
      "required": ["group"],
      "properties": {
        "group": { "enum": ["None", "SmallProp", "LargeProp", "LevelArchitecture"] }
      },
      "additionalProperties": false
    },
    "vector": {
      "type": "object",
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      },
      "additionalProperties": false
    },
    "rotation": {
      "type": "object",
      "required": ["pitch", "yaw", "roll"],
      "properties": {
        "pitch": { "type": "number" },
        "yaw": { "type": "number" },
        "roll": { "type": "number" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
