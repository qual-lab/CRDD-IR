{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crdd.dev/schema/regression-manifest/v0.1.json",
  "title": "CRDD Product Regression Manifest v0.1",
  "type": "object",
  "required": ["protocol", "operations"],
  "properties": {
    "protocol": { "const": "crdd-ir/regression-manifest-v0.1" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "adapterKey", "source", "conformance", "traces"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "adapterKey": { "type": "string", "minLength": 1 },
          "source": {
            "type": "object",
            "required": ["path", "sha256", "irSha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "$ref": "#/$defs/sha256" },
              "irSha256": { "$ref": "#/$defs/sha256" }
            },
            "additionalProperties": false
          },
          "conformance": {
            "type": "object",
            "required": [
              "path",
              "sha256",
              "cases",
              "successCases",
              "failureCases"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+\\.conformance\\.json$"
              },
              "sha256": { "$ref": "#/$defs/sha256" },
              "cases": { "type": "integer", "minimum": 1 },
              "successCases": { "type": "integer", "minimum": 1 },
              "failureCases": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          },
          "traces": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
