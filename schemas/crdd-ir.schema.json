{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crdd.dev/schema/ir/v0.1.json",
  "title": "CRDD IR v0.1",
  "type": "object",
  "required": ["irVersion", "operation"],
  "properties": {
    "irVersion": { "const": "0.1" },
    "operation": {
      "type": "object",
      "required": ["id", "kind", "traces", "input", "state", "requires", "effects", "errors"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["command", "query"] },
        "traces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "input": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/field" }
        },
        "state": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/field" }
        },
        "output": { "$ref": "#/$defs/field" },
        "requires": {
          "type": "array",
          "items": { "$ref": "#/$defs/requirement" }
        },
        "portableRules": {
          "type": "array",
          "items": { "$ref": "#/$defs/portableRule" }
        },
        "effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/effect" }
        },
        "errors": { "type": "array" },
        "conformance": { "$ref": "#/$defs/irConformance" },
        "execution": { "$ref": "#/$defs/execution" },
        "emits": {
          "type": "array",
          "items": { "$ref": "#/$defs/event" }
        },
        "extensions": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9.-]*$" },
          "additionalProperties": { "$ref": "#/$defs/extension" }
        },
        "transaction": {
          "type": "object",
          "required": ["atomic", "rollbackOnFailure"],
          "properties": {
            "atomic": { "type": "boolean" },
            "rollbackOnFailure": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "$defs": {
    "fixtureValues": {
      "type": "object",
      "properties": {
        "input": { "type": "object" },
        "state": { "type": "object" }
      },
      "additionalProperties": false
    },
    "irConformance": {
      "type": "object",
      "properties": {
        "baseline": { "$ref": "#/$defs/fixtureValues" },
        "seeds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "when"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "when": { "type": "string", "minLength": 1 },
              "input": { "type": "object" },
              "state": { "type": "object" }
            },
            "anyOf": [{ "required": ["input"] }, { "required": ["state"] }],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "requirement": {
      "type": "object",
      "required": ["id", "expression", "error"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "expression": { "type": "string", "minLength": 1 },
        "error": { "type": "string", "minLength": 1 },
        "when": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "extension": {
      "type": "object",
      "required": ["protocol", "data"],
      "properties": {
        "protocol": { "type": "string", "minLength": 1 },
        "data": {}
      },
      "additionalProperties": false
    },
    "portableRule": {
      "oneOf": [
      {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "id", "error", "source", "hash"],
        "properties": {
          "kind": { "const": "evidence.canonical-hash" },
          "id": { "type": "string", "minLength": 1 },
          "error": { "type": "string", "minLength": 1 },
          "source": {
            "enum": ["input", "state"],
            "description": "Selected scope must not contain binary floating-point number fields; use canonical decimal strings."
          },
          "hash": { "type": "string", "minLength": 1 }
        }
      },
      {
        "type": "object",
          "required": ["kind", "id", "error", "collection"],
          "properties": {
            "kind": { "const": "collection.unique" },
            "id": { "type": "string", "minLength": 1 },
            "error": { "type": "string", "minLength": 1 },
            "collection": { "type": "string", "minLength": 1 },
            "key": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "id", "error", "collection", "reference", "target", "targetKey"],
          "properties": {
            "kind": { "const": "collection.reference" },
            "id": { "type": "string", "minLength": 1 },
            "error": { "type": "string", "minLength": 1 },
            "collection": { "type": "string", "minLength": 1 },
            "reference": { "type": "string", "minLength": 1 },
            "target": { "type": "string", "minLength": 1 },
            "targetKey": { "type": "string", "minLength": 1 },
            "targetType": { "$ref": "#/$defs/typeFilter" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "id", "error", "collection", "parentReference", "parents", "parentKey"],
          "properties": {
            "kind": { "const": "collection.membership" },
            "id": { "type": "string", "minLength": 1 },
            "error": { "type": "string", "minLength": 1 },
            "collection": { "type": "string", "minLength": 1 },
            "parentReference": { "type": "string", "minLength": 1 },
            "parents": { "type": "string", "minLength": 1 },
            "parentKey": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "id", "error", "collection", "from", "to", "elements", "elementKey"],
          "properties": {
            "kind": { "const": "collection.relation" },
            "id": { "type": "string", "minLength": 1 },
            "error": { "type": "string", "minLength": 1 },
            "collection": { "type": "string", "minLength": 1 },
            "from": { "type": "string", "minLength": 1 },
            "to": { "type": "string", "minLength": 1 },
            "elements": { "type": "string", "minLength": 1 },
            "elementKey": { "type": "string", "minLength": 1 },
            "fromType": { "$ref": "#/$defs/typeFilter" },
            "toType": { "$ref": "#/$defs/typeFilter" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "id", "error", "value", "collection", "targetKey"],
          "properties": {
            "kind": { "const": "collection.not-contains" },
            "id": { "type": "string", "minLength": 1 },
            "error": { "type": "string", "minLength": 1 },
            "value": { "type": "string", "minLength": 1 },
            "collection": { "type": "string", "minLength": 1 },
            "targetKey": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "id", "error", "candidates", "candidateKey", "existing", "existingKey"],
          "properties": {
            "kind": { "const": "collection.prospective-unique" },
            "id": { "type": "string", "minLength": 1 },
            "error": { "type": "string", "minLength": 1 },
            "candidates": { "type": "string", "minLength": 1 },
            "candidateKey": { "type": "string", "minLength": 1 },
            "existing": { "type": "string", "minLength": 1 },
            "existingKey": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "id", "error", "target"],
          "properties": {
            "kind": { "const": "opaque.integrity" },
            "id": { "type": "string", "minLength": 1 },
            "error": { "type": "string", "minLength": 1 },
            "target": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "id", "error", "current", "proposed"],
          "properties": {
            "kind": { "const": "opaque.immutable-when-inactive" },
            "id": { "type": "string", "minLength": 1 },
            "error": { "type": "string", "minLength": 1 },
            "current": { "type": "string", "minLength": 1 },
            "proposed": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "id", "error", "current", "intent"],
          "properties": {
            "kind": { "const": "opaque.reject-edit-when-inactive" },
            "id": { "type": "string", "minLength": 1 },
            "error": { "type": "string", "minLength": 1 },
            "current": { "type": "string", "minLength": 1 },
            "intent": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    },
    "typeFilter": {
      "type": "object",
      "required": ["field", "equals"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "equals": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "effect": {
      "oneOf": [
        {
          "type": "object",
          "required": ["target", "action", "expression"],
          "properties": {
            "target": { "type": "string", "minLength": 1 },
            "action": { "enum": ["assign", "increment"] },
            "expression": { "type": "string", "minLength": 1 },
            "when": { "type": "string", "minLength": 1 },
            "traces": { "$ref": "#/$defs/traces" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["target", "action", "value"],
          "properties": {
            "target": { "type": "string", "minLength": 1 },
            "action": { "const": "append" },
            "value": {},
            "when": { "type": "string", "minLength": 1 },
            "traces": { "$ref": "#/$defs/traces" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["target", "action", "where"],
          "properties": {
            "target": { "type": "string", "minLength": 1 },
            "action": { "const": "remove" },
            "where": { "type": "object", "minProperties": 1 },
            "when": { "type": "string", "minLength": 1 },
            "traces": { "$ref": "#/$defs/traces" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["target", "action", "where", "set"],
          "properties": {
            "target": { "type": "string", "minLength": 1 },
            "action": { "const": "update" },
            "where": { "type": "object", "minProperties": 1 },
            "set": { "type": "object", "minProperties": 1 },
            "when": { "type": "string", "minLength": 1 },
            "traces": { "$ref": "#/$defs/traces" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "encoding", "digest"],
          "properties": {
            "type": { "const": "opaque" },
            "encoding": { "const": "base64" },
            "digest": { "const": "sha256" },
            "optional": { "type": "boolean" },
            "nullable": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      ]
    },
    "scalar": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["number", "integer", "string", "boolean"] },
        "unit": { "type": "string", "minLength": 1 },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "minLength": { "type": "integer", "minimum": 0 },
        "maxLength": { "type": "integer", "minimum": 0 },
        "pattern": { "type": "string" },
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "optional": { "type": "boolean" },
        "nullable": { "type": "boolean" },
        "default": { "type": ["number", "string", "boolean"] }
      },
      "additionalProperties": false
    },
    "object": {
      "type": "object",
      "required": ["type", "properties"],
      "properties": {
        "type": { "const": "object" },
        "properties": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/field" }
        },
        "optional": { "type": "boolean" },
        "nullable": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "field": {
      "oneOf": [
        { "$ref": "#/$defs/scalar" },
        { "$ref": "#/$defs/object" },
        {
          "type": "object",
          "required": ["type", "items"],
          "properties": {
            "type": { "const": "array" },
            "items": { "$ref": "#/$defs/field" },
            "minItems": { "type": "integer", "minimum": 0 },
            "maxItems": { "type": "integer", "minimum": 0 },
            "optional": { "type": "boolean" },
            "nullable": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "values"],
          "properties": {
            "type": { "const": "map" },
            "values": { "$ref": "#/$defs/field" },
            "optional": { "type": "boolean" },
            "nullable": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "discriminator", "variants"],
          "properties": {
            "type": { "const": "union" },
            "discriminator": { "type": "string", "minLength": 1 },
            "variants": {
              "type": "array",
              "minItems": 2,
              "items": { "$ref": "#/$defs/object" }
            },
            "optional": { "type": "boolean" },
            "nullable": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      ]
    },
    "execution": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["sync", "async"] },
        "cancelable": { "type": "boolean" },
        "timeoutMs": { "type": "integer", "exclusiveMinimum": 0 },
        "idempotency": { "enum": ["none", "optional", "required"] }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["type", "traces"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "payload": { "$ref": "#/$defs/field" },
        "delivery": { "enum": ["at-most-once", "at-least-once"] },
        "traces": { "$ref": "#/$defs/traces" }
      },
      "additionalProperties": false
    },
    "traces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
