{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crdd.dev/schema/ir/v0.1.json",
  "title": "CRDD IR v0.1",
  "type": "object",
  "required": ["irVersion", "operation"],
  "properties": {
    "irVersion": { "const": "0.1" },
    "operation": {
      "type": "object",
      "required": ["id", "traces", "input", "state", "requires", "effects", "errors", "transaction"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "traces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "input": { "type": "object" },
        "state": { "type": "object" },
        "requires": { "type": "array", "minItems": 1 },
        "effects": { "type": "array", "minItems": 1 },
        "errors": { "type": "array", "minItems": 1 },
        "transaction": {
          "type": "object",
          "required": ["atomic", "rollbackOnFailure"],
          "properties": {
            "atomic": { "type": "boolean" },
            "rollbackOnFailure": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "additionalProperties": false
}
