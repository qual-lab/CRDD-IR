{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crdd.dev/schema/source-contract/v0.1.json",
  "title": "CRDD Source Contract v0.1",
  "type": "object",
  "required": ["schema", "operation"],
  "properties": {
    "schema": { "const": "crdd-source-contract/v0.1" },
    "operation": {
      "type": "object",
      "required": ["id", "traces", "input", "state", "requires", "effects", "errors", "transaction"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "traces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "input": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/field" }
        },
        "state": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/field" }
        },
        "requires": { "type": "array", "minItems": 1 },
        "effects": { "type": "array", "minItems": 1 },
        "errors": { "type": "array", "minItems": 1 },
        "transaction": {
          "type": "object",
          "required": ["atomic", "rollback_on_failure"],
          "properties": {
            "atomic": { "type": "boolean" },
            "rollback_on_failure": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "$defs": {
    "scalar": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["number", "string", "boolean"] },
        "unit": { "type": "string", "minLength": 1 },
        "minimum": { "type": "number" }
      },
      "additionalProperties": false
    },
    "object": {
      "type": "object",
      "required": ["type", "properties"],
      "properties": {
        "type": { "const": "object" },
        "properties": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/scalar" }
        }
      },
      "additionalProperties": false
    },
    "field": {
      "oneOf": [
        { "$ref": "#/$defs/scalar" },
        {
          "type": "object",
          "required": ["type", "items"],
          "properties": {
            "type": { "const": "array" },
            "items": { "$ref": "#/$defs/object" }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
