{
  "protocol": "crdd-ir/conformance-v0.1",
  "operation": "PlaceWall",
  "traces": [
    "REQ-WALL-001",
    "DEC-WALL-003"
  ],
  "cases": [
    {
      "id": "place-wall-success",
      "description": "PlaceWall succeeds when every precondition is satisfied",
      "request": {
        "input": {
          "length": 1,
          "cost": 100
        },
        "state": {
          "budget": {
            "remaining": 1000000
          },
          "walls": []
        }
      },
      "expected": {
        "ok": true,
        "operation": "PlaceWall",
        "state": {
          "budget": {
            "remaining": 999900
          },
          "walls": [
            {
              "length": 1,
              "cost": 100
            }
          ]
        },
        "traces": [
          "REQ-WALL-001",
          "DEC-WALL-003"
        ]
      }
    },
    {
      "id": "minimum-wall-length-at-boundary",
      "description": "length equal to 0.3 is accepted",
      "sourceRequirement": "minimum-wall-length",
      "request": {
        "input": {
          "length": 0.3,
          "cost": 100
        },
        "state": {
          "budget": {
            "remaining": 1000000
          },
          "walls": []
        }
      },
      "expected": {
        "ok": true,
        "operation": "PlaceWall",
        "state": {
          "budget": {
            "remaining": 999900
          },
          "walls": [
            {
              "length": 0.3,
              "cost": 100
            }
          ]
        },
        "traces": [
          "REQ-WALL-001",
          "DEC-WALL-003"
        ]
      }
    },
    {
      "id": "minimum-wall-length-below-boundary",
      "description": "length below 0.3 is rejected without state changes",
      "sourceRequirement": "minimum-wall-length",
      "request": {
        "input": {
          "length": 0.299,
          "cost": 100
        },
        "state": {
          "budget": {
            "remaining": 1000000
          },
          "walls": []
        }
      },
      "expected": {
        "ok": false,
        "operation": "PlaceWall",
        "error": "WALL_TOO_SHORT",
        "failedRequirement": "minimum-wall-length",
        "state": {
          "budget": {
            "remaining": 1000000
          },
          "walls": []
        },
        "traces": [
          "REQ-WALL-001"
        ]
      }
    },
    {
      "id": "sufficient-budget-exact",
      "description": "budget.remaining equal to cost is accepted",
      "sourceRequirement": "sufficient-budget",
      "request": {
        "input": {
          "length": 1,
          "cost": 100
        },
        "state": {
          "budget": {
            "remaining": 100
          },
          "walls": []
        }
      },
      "expected": {
        "ok": true,
        "operation": "PlaceWall",
        "state": {
          "budget": {
            "remaining": 0
          },
          "walls": [
            {
              "length": 1,
              "cost": 100
            }
          ]
        },
        "traces": [
          "REQ-WALL-001",
          "DEC-WALL-003"
        ]
      }
    },
    {
      "id": "sufficient-budget-insufficient",
      "description": "budget.remaining one unit below cost is rejected without state changes",
      "sourceRequirement": "sufficient-budget",
      "request": {
        "input": {
          "length": 1,
          "cost": 100
        },
        "state": {
          "budget": {
            "remaining": 99
          },
          "walls": []
        }
      },
      "expected": {
        "ok": false,
        "operation": "PlaceWall",
        "error": "INSUFFICIENT_BUDGET",
        "failedRequirement": "sufficient-budget",
        "state": {
          "budget": {
            "remaining": 99
          },
          "walls": []
        },
        "traces": [
          "DEC-WALL-003"
        ]
      }
    }
  ]
}
