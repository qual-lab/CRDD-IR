{
  "protocol": "crdd-ir/conformance-v0.1",
  "operation": "UpdateEntity",
  "traces": [
    "REQ-ENTITY-UPDATE-001"
  ],
  "cases": [
    {
      "id": "update-entity-success",
      "description": "UpdateEntity succeeds when every precondition is satisfied",
      "request": {
        "input": {
          "entity_id": "sample",
          "new_length": 1,
          "options": {
            "mode": "replace"
          }
        },
        "state": {
          "audit": {
            "mode": "preserve_metadata"
          },
          "entities": [
            {
              "entity_id": "sample",
              "length": 0
            }
          ]
        }
      },
      "expected": {
        "ok": true,
        "operation": "UpdateEntity",
        "state": {
          "audit": {
            "mode": "replace"
          },
          "entities": [
            {
              "entity_id": "sample",
              "length": 1
            }
          ]
        },
        "traces": [
          "REQ-ENTITY-UPDATE-001"
        ]
      }
    },
    {
      "id": "minimum-entity-length-at-boundary",
      "description": "new_length equal to 0.3 is accepted",
      "sourceRequirement": "minimum-entity-length",
      "request": {
        "input": {
          "entity_id": "sample",
          "new_length": 0.3,
          "options": {
            "mode": "replace"
          }
        },
        "state": {
          "audit": {
            "mode": "preserve_metadata"
          },
          "entities": [
            {
              "entity_id": "sample",
              "length": 0
            }
          ]
        }
      },
      "expected": {
        "ok": true,
        "operation": "UpdateEntity",
        "state": {
          "audit": {
            "mode": "replace"
          },
          "entities": [
            {
              "entity_id": "sample",
              "length": 0.3
            }
          ]
        },
        "traces": [
          "REQ-ENTITY-UPDATE-001"
        ]
      }
    },
    {
      "id": "minimum-entity-length-below-boundary",
      "description": "new_length below 0.3 is rejected without state changes",
      "sourceRequirement": "minimum-entity-length",
      "request": {
        "input": {
          "entity_id": "sample",
          "new_length": 0.299,
          "options": {
            "mode": "replace"
          }
        },
        "state": {
          "audit": {
            "mode": "preserve_metadata"
          },
          "entities": [
            {
              "entity_id": "sample",
              "length": 0
            }
          ]
        }
      },
      "expected": {
        "ok": false,
        "operation": "UpdateEntity",
        "error": "ENTITY_TOO_SHORT",
        "failedRequirement": "minimum-entity-length",
        "state": {
          "audit": {
            "mode": "preserve_metadata"
          },
          "entities": [
            {
              "entity_id": "sample",
              "length": 0
            }
          ]
        },
        "traces": [
          "REQ-ENTITY-UPDATE-001"
        ]
      }
    },
    {
      "id": "valid-entity-id-falsified",
      "description": "valid-entity-id is rejected by a deterministic counterexample",
      "sourceRequirement": "valid-entity-id",
      "request": {
        "input": {
          "entity_id": "",
          "new_length": 1,
          "options": {
            "mode": "replace"
          }
        },
        "state": {
          "audit": {
            "mode": "preserve_metadata"
          },
          "entities": [
            {
              "entity_id": "sample",
              "length": 0
            }
          ]
        }
      },
      "expected": {
        "ok": false,
        "operation": "UpdateEntity",
        "error": "ENTITY_ID_REQUIRED",
        "failedRequirement": "valid-entity-id",
        "state": {
          "audit": {
            "mode": "preserve_metadata"
          },
          "entities": [
            {
              "entity_id": "sample",
              "length": 0
            }
          ]
        },
        "traces": [
